# SPDX-License-Identifier: Apache-2.0
# generated_harnesses/{{ harness_id }}/Makefile

.DEFAULT_GOAL := all

ifeq ($(origin CC), default)
CC = {{ c_compiler }}
endif
# The instrumentation flags are chosen from the compiler that actually runs, at
# build time rather than when this file was generated: `bhf build`/`bhf auto`
# probe $(CC) once and pass BHF_CC_FAMILY, and a hand-run `make` asks $(CC) for
# its predefined macros. So CC=gcc, a cross-prefixed gcc or a vendor gcc gets
# GCC-spelled flags (`trace-pc`, no `function` UBSan check), and clang gets its
# own, whatever compiler the build context named.
# `bhf-cl` is bhf's front end for MSVC `cl.exe`: it reads these GCC-style
# command lines and runs cl with the equivalent options (see the msvc family
# below), so it is recognised by name.
ifndef BHF_CC_FAMILY
ifneq ($(filter bhf-cl bhf-cl.exe,$(notdir $(subst ",,$(CC)))),)
BHF_CC_FAMILY := msvc
else
BHF_CC_FAMILY := $(shell bhf_macros=$$(echo | $(CC) -dM -E -x c - 2>/dev/null); case "$$bhf_macros" in (*__clang__*) echo clang;; (*__GNUC__*) echo gcc;; (*) echo {{ c_compiler_family }};; esac)
endif
endif
# Every bhf C direct harness (generated or passthrough) ships its own
# lightweight `main` — a persistent framed fork-server driver (#399/#398) — so we
# do NOT link libFuzzer's own `main` (the `fuzzer` sanitizer runtime); mixing the
# two crashed in driver glue (#388). `trace-pc-guard` feeds the harness's
# edge-coverage runtime (#385). `trace-cmp` feeds two consumers of comparison
# operands: the value-profile runtime that mines them into the dictionary (#398)
# and the RedQueen/cmplog capture that records operand pairs so the mutator can
# splice them at the offset they were compared (input-to-state, #400). ASan's
# str/mem-cmp interceptors call the harness's __sanitizer_weak_hook_* family for
# the same end. The engine drives it persistently.
# UBSan runs with abort_on_error=1:halt_on_error=1 under the engine, so a check
# that fires on legitimate-but-technically-UB code aborts on EVERY input and the
# target is reported as a runtime error with 0 executions instead of being
# fuzzed. We drop the three checks that fire on pervasive, harmless patterns —
# the set OSS-Fuzz also excludes: `function` (a typed callback called through a
# generic fn-pointer signature — every C stream/iterator/vtable interface, e.g.
# TinySoundFont), `vptr` (C++ vptr checks need RTTI, fire on legitimate
# downcasts), and `alignment` (binary parsers read `*(uint32_t*)p` at unaligned
# offsets). All high-signal checks (overflow, shift, OOB, null, return…) stay
# on. -fno-sanitize= must follow -fsanitize=undefined to subtract from the group.
# Legacy-C dialect ladder. EMPTY by default, so a normal build carries no -std
# at all and behaves exactly as it always has. The repair loop sets it (`make
# C_STD=gnu89`) when a modern default rejects pre-standard C, mirroring CXX_STD
# on the C++ side.
#
# C_STD_FLAG is spliced AFTER COMPILE_DB_FLAGS in every recipe, and the order is
# load-bearing: a recovered compile database routinely carries the project's own
# `-std=` (clay's build pins `-std=c99`), and only C++ standards are lifted out of
# COMPILE_DB_FLAGS. With C_STD_FLAG first, that recovered `-std=` came later on the
# command line and won, so every rung of the C dialect ladder was silently a no-op
# — `make C_STD=gnu11` still compiled as c99, and a C11-only construct
# (`U'\u2580'`, a UTF-32 literal) could never build no matter how many rungs ran.
# Last one wins, so the ladder's choice has to be last.
C_STD ?=
C_STD_FLAG := $(if $(C_STD),-std=$(C_STD),)

# GCC links its sanitizer runtimes as shared libraries by default, and a
# shared libasan must come first in the process's library list: under the
# runtrace LD_PRELOAD shim it aborts at startup before the target is ever
# reached. Link them statically, as clang does.
ifeq ($(BHF_CC_FAMILY),gcc)
CFLAGS ?= -O1 -g -fsanitize=address,undefined -fno-sanitize=alignment -static-libasan -static-libubsan -fsanitize-coverage=trace-pc,trace-cmp
else ifeq ($(BHF_CC_FAMILY),msvc)
# MSVC: AddressSanitizer plus the SanitizerCoverage subset cl implements —
# inline 8-bit edge counters, which bhf's driver folds into the edge map after
# every input, and the comparison and division hooks. cl has no UBSan.
CFLAGS ?= -O1 -g -fsanitize=address -fsanitize-coverage=inline-8bit-counters,edge,trace-cmp,trace-div
else
CFLAGS ?= -O1 -g -fsanitize=address,undefined -fno-sanitize=function,vptr,alignment -fsanitize-coverage=trace-pc-guard,trace-cmp
endif
# Toolchain additions from a `[toolchain]` config table or the --cflags /
# --define / --sysroot ... flags. They are APPENDED, so they never drop bhf's
# coverage or sanitizers. Every lane takes BHF_TOOLCHAIN_CPPFLAGS (defines,
# include dirs), BHF_TOOLCHAIN_C_CPPFLAGS (the preprocessor words of the C
# flags: -D, -U, -I, -isystem, -include) and BHF_TOOLCHAIN_LIBS (the library
# operands of the link flags: -L, -l, archives and objects, -Wl,-rpath,
# -pthread), so the coverage, AFL++, libFuzzer, MemorySanitizer,
# ThreadSanitizer and differential builds see the same headers and libraries
# as `main`. The rest of the C and link flags, which may be specific to the
# toolchain's compiler, reach only the lanes built with $(CC).
BHF_TOOLCHAIN_CFLAGS ?=
BHF_TOOLCHAIN_CPPFLAGS ?=
BHF_TOOLCHAIN_C_CPPFLAGS ?=
# The -D, -U, -I and -isystem words of the C flags, which bhf's driver object
# takes too (a header dir a bare-metal toolchain needs); never -include.
BHF_TOOLCHAIN_DRIVER_CFLAGS ?=
BHF_TOOLCHAIN_LDFLAGS ?=
BHF_TOOLCHAIN_LIBS ?=
BHF_TOOLCHAIN_TARGET_FLAGS ?=
# glibc's _FORTIFY_SOURCE, which Ubuntu's gcc defines whenever it optimizes,
# turns an overflow in a fortified call (strcpy, memcpy, sprintf) into its own
# `*** buffer overflow detected ***` abort before AddressSanitizer can report
# it. A lane built with a sanitizer turns it off, after the build context's
# and the toolchain's own flags; a lane without one keeps the platform's
# fortification. The compiler hands -Wp, words to the preprocessor after every
# -D and -U, so a -Wp,-D_FORTIFY_SOURCE=N (Fedora's, RHEL's and Arch's build
# flags) would beat a plain -U: the override ends with the -Wp, spelling, and
# the plain -U keeps gcc's own default define out. No plain -D, which clang
# would warn a later -Wp,-D redefines (fatal under -Werror). Harmless for
# clang.
BHF_NO_FORTIFY = -U_FORTIFY_SOURCE -Wp,-U_FORTIFY_SOURCE -Wp,-D_FORTIFY_SOURCE=0
BHF_SANITIZED_NO_FORTIFY = $(if $(filter -fsanitize=%,$(1)),$(BHF_NO_FORTIFY))
# Isolate each function/data object so the linker can discard unrelated code in
# a legacy amalgamation or application TU. Otherwise an isolated target inherits
# undefined references from every unused function in the same source file.
SECTION_FLAGS ?= -ffunction-sections -fdata-sections
ifeq ($(shell uname -s),Darwin)
SECTION_LDFLAGS ?= -Wl,-dead_strip
else
SECTION_LDFLAGS ?= -Wl,--gc-sections
endif
# Auto writes this optional project-level fragment only after a modern linker
# proves that legacy tentative definitions need the pre-GCC-10 `-fcommon`
# behavior. Keeping it separate preserves modern defaults for ordinary C.
-include ../../c_compat.mk
C_COMPAT_FLAGS ?=
# POSIX feature-test macros, as command-line -D rather than a `#define` in the
# harness source. `-include auto_cpp_includes.h` is processed BEFORE main.c, so
# a project header (or the libc headers it pulls) can lock glibc's feature-test
# macros in before main.c's own `#ifndef _GNU_SOURCE` is ever seen. Under a
# strict `-std=c99` from the project's compile database that leaves bhf's
# OWN runtime without `mkstemp`/`ftruncate` (c_runtime/bhf_decode.h), so the
# harness fails to build for a reason that has nothing to do with the target.
FEATURE_TEST_FLAGS ?= -D_GNU_SOURCE -D_DEFAULT_SOURCE
# AFL's compiler driver reserves the AFL_ env-var namespace, so the AFL
# build knobs use the AFLPP_ prefix to avoid colliding with it.
AFLPP_CC ?= afl-clang-fast
AFLPP_CFLAGS ?= -O1 -g -fsanitize=address,undefined -fno-sanitize=function,vptr,alignment -DBHF_AFL
# libFuzzer build: a portable, coverage-guided binary for external drivers
# (libFuzzer itself, Mayhem's coverage-guided mode, honggfuzz's hfuzz-cc). It
# reuses the harness's stable `bhf_run_one` via the generated `bhf_libfuzzer.c`
# shim (which supplies `LLVMFuzzerTestOneInput` and a no-op `bhf_target_enter`)
# and is linked WITHOUT bhf's own fork-server driver (`bhf_driver.o`) so that
# `-fsanitize=fuzzer` provides `main` and the coverage runtime. clang only —
# gcc has no libFuzzer — so this stays clang regardless of the project default.
LIBFUZZER_CC ?= clang
LIBFUZZER_CFLAGS ?= -O1 -g -fno-omit-frame-pointer -fsanitize=fuzzer,address,undefined -fno-sanitize=function,vptr,alignment
# MemorySanitizer build: finds reads of UNINITIALIZED memory (CWE-457/908) — a
# whole bug class ASan/UBSan miss. MSan is mutually exclusive with ASan, so it is a
# separate binary that `auto` replays the ASan pass's corpus through (no new fuzz
# loop). track-origins reports where the uninitialized value came from.
MSAN_CC ?= clang
MSAN_CFLAGS ?= -O1 -g -fsanitize=memory -fsanitize-memory-track-origins=2 -fno-omit-frame-pointer -fsanitize-coverage=trace-pc-guard,trace-cmp
# ThreadSanitizer build: finds data races (CWE-362) — concurrent unsynchronized
# access to shared memory, a bug class ASan/UBSan miss. TSan is mutually exclusive
# with ASan, so it is a separate binary that `auto` replays the ASan pass's corpus
# through (no new fuzz loop). A race only surfaces when the target itself spawns
# threads while processing one input; single-threaded targets simply find none.
# Built at -O0: the replay binary is for race DETECTION, not speed, and higher
# optimization elides/reorders the unsynchronized stores TSan keys on (a write with
# no observed read is dead-store-eliminated), hiding real races.
TSAN_CC ?= clang
TSAN_CFLAGS ?= -O0 -g -fsanitize=thread -fsanitize-coverage=trace-pc-guard,trace-cmp
# Source-based coverage build: `auto` replays the fuzz corpus through it and reads
# per-line hit counts via llvm-cov to learn which lines the campaign EXECUTED — the
# positive evidence for negative fuzz-confirmation (a covered-but-survived static
# finding is a likely false positive) on the C/C++ lanes.
COV_CC ?= clang
COV_CFLAGS ?= -O0 -g -fprofile-instr-generate -fcoverage-mapping
# Differential build (two-compiler): a PORTABLE build (no clang-only coverage or
# UBSan-check subtraction) so the SAME source compiles under clang AND gcc, and
# `auto --differential A:B` can replay the corpus through both and flag inputs on
# which the two builds diverge in exit/crash behavior (BHF-301). ASan stays on —
# it has identical semantics across clang/gcc — so a codegen-dependent memory bug
# that only one compiler's output triggers still surfaces as an exit divergence.
DIFF_CC ?= clang
DIFF_CFLAGS ?= -O2 -g -fsanitize=address
BHF_DRIVER_SOURCE ?= {{ bhf_driver_source }}
BHF_DRIVER_CFLAGS ?= -O1 -g
# bhf's driver object takes the toolchain's C flags too, so a flag that selects
# the ABI (-m32, -mabi=..., -mbig-endian) applies to every object of the link.
# Its dialect and warning policy stay bhf's own: -std= and -Werror are left out.
BHF_DRIVER_TOOLCHAIN_CFLAGS = $(filter-out -std=% -Werror% -pedantic-errors,$(BHF_TOOLCHAIN_CFLAGS) $(BHF_TOOLCHAIN_DRIVER_CFLAGS))
INCLUDES = -I . -I {{ c_runtime_include }}{% for inc in target_includes_dirs %} -iquote {{ inc }} -idirafter {{ inc }}{% endfor %}
BUILD_CONTEXT_PROVENANCE = {{ build_context_provenance }}
BUILD_CONTEXT_DROPPED = {{ build_context_dropped }}
COMPILE_DB_FLAGS = {% for flag in compile_flags %}{{ flag }}{% if not loop.last %} {% endif %}{% endfor %}
BUILD_CONTEXT_LDFLAGS = {% for flag in link_flags %}{{ flag }}{% if not loop.last %} {% endif %}{% endfor %}
# Toolchain stamp: every object and binary built with $(CC) depends on it, and
# it is rewritten only when the compiler or its flags change. Switching
# compilers in the same harness directory (bhf's gcc retry, a cross build, a
# different CC= between runs) therefore rebuilds bhf_driver.o and relinks,
# instead of linking objects the previous compiler produced.
BHF_TOOLCHAIN_ID = $(CC) $(BHF_CC_FAMILY) $(MSAN_CC) $(TSAN_CC) $(COV_CC) $(DIFF_CC) | $(CFLAGS) | $(C_COMPAT_FLAGS) $(C_STD) | $(BHF_DRIVER_CFLAGS) | $(BHF_TOOLCHAIN_TARGET_FLAGS) | $(BHF_TOOLCHAIN_CFLAGS) | $(BHF_TOOLCHAIN_CPPFLAGS) | $(BHF_TOOLCHAIN_C_CPPFLAGS) | $(BHF_TOOLCHAIN_DRIVER_CFLAGS) | $(BHF_TOOLCHAIN_LDFLAGS) | $(BHF_TOOLCHAIN_LIBS)
-include build_context_objects.mk
-include repair_context_objects.mk
CONTEXT_MAIN_OBJECTS ?=
CONTEXT_AFL_OBJECTS ?=
CONTEXT_MSAN_OBJECTS ?=
CONTEXT_TSAN_OBJECTS ?=
CONTEXT_COV_OBJECTS ?=
CONTEXT_DIFF_OBJECTS ?=
CONTEXT_PROV_OBJECTS ?=
REPAIR_CONTEXT_MAIN_OBJECTS ?=
REPAIR_CONTEXT_AFL_OBJECTS ?=
REPAIR_CONTEXT_MSAN_OBJECTS ?=
REPAIR_CONTEXT_TSAN_OBJECTS ?=
REPAIR_CONTEXT_COV_OBJECTS ?=
REPAIR_CONTEXT_DIFF_OBJECTS ?=
REPAIR_CONTEXT_PROV_OBJECTS ?=

ifdef BHF_CONTEXT_PREPARE_FAILED
$(error $(BHF_CONTEXT_PREPARE_FAILED))
endif

.PHONY: all afl libfuzzer msan tsan cov prov diff syntaxcheck clean FORCE_TOOLCHAIN_STAMP
all: main

bhf_toolchain.stamp: FORCE_TOOLCHAIN_STAMP
	@bhf_id='$(subst ','\'',$(BHF_TOOLCHAIN_ID))'; if [ "$$(cat $@ 2>/dev/null)" != "$$bhf_id" ]; then printf '%s\n' "$$bhf_id" > $@; fi

# Target sources stay OUT of the prerequisites and live only in the recipe: an
# absolute Windows source path carries a drive-letter colon (`C:\...`) which GNU
# make parses as a target:prereq separator ("multiple target patterns"). In the
# recipe the path is just an argument to the compiler, so the colon is harmless.
# The same holds for a path with spaces: make splits a prerequisite on them
# whatever the quoting, while the recipe hands the double-quoted path to the
# shell as one word. (bhf regenerates the harness dir per attempt, so `main` is
# always built.)
bhf_driver.o:{% if bhf_driver_prereq %} $(BHF_DRIVER_SOURCE){% endif %} bhf_toolchain.stamp
	$(CC) $(BHF_DRIVER_CFLAGS) $(BHF_TOOLCHAIN_TARGET_FLAGS) $(BHF_DRIVER_TOOLCHAIN_CFLAGS) $(FEATURE_TEST_FLAGS) -c -o $@ $(BHF_DRIVER_SOURCE)

# The lanes built with their own compiler (MemorySanitizer, ThreadSanitizer,
# source coverage, differential) link a driver object from that compiler, so an
# operator's gcc or cross $(CC) never mixes into those binaries.
bhf_driver_msan.o:{% if bhf_driver_prereq %} $(BHF_DRIVER_SOURCE){% endif %} bhf_toolchain.stamp
	$(MSAN_CC) $(BHF_DRIVER_CFLAGS) $(FEATURE_TEST_FLAGS) -c -o $@ $(BHF_DRIVER_SOURCE)

bhf_driver_tsan.o:{% if bhf_driver_prereq %} $(BHF_DRIVER_SOURCE){% endif %} bhf_toolchain.stamp
	$(TSAN_CC) $(BHF_DRIVER_CFLAGS) $(FEATURE_TEST_FLAGS) -c -o $@ $(BHF_DRIVER_SOURCE)

bhf_driver_cov.o:{% if bhf_driver_prereq %} $(BHF_DRIVER_SOURCE){% endif %} bhf_toolchain.stamp
	$(COV_CC) $(BHF_DRIVER_CFLAGS) $(FEATURE_TEST_FLAGS) -c -o $@ $(BHF_DRIVER_SOURCE)

bhf_driver_diff.o:{% if bhf_driver_prereq %} $(BHF_DRIVER_SOURCE){% endif %} bhf_toolchain.stamp
	$(DIFF_CC) $(BHF_DRIVER_CFLAGS) $(FEATURE_TEST_FLAGS) -c -o $@ $(BHF_DRIVER_SOURCE)

main: main.c bhf_driver.o bhf_toolchain.stamp $(CONTEXT_MAIN_OBJECTS) $(REPAIR_CONTEXT_MAIN_OBJECTS)
	$(CC) $(CFLAGS) $(SECTION_FLAGS) $(C_COMPAT_FLAGS) $(FEATURE_TEST_FLAGS) $(COMPILE_DB_FLAGS) $(BHF_TOOLCHAIN_TARGET_FLAGS) $(BHF_TOOLCHAIN_CFLAGS) $(C_STD_FLAG) $(INCLUDES) $(AUTO_EXTRA_INCLUDES) $(BHF_TOOLCHAIN_CPPFLAGS) $(BHF_TOOLCHAIN_C_CPPFLAGS) $(call BHF_SANITIZED_NO_FORTIFY,$(CFLAGS)) -DBHF_EXTERNAL_DRIVER -o $@ main.c{% for src in target_sources %} {{ src }}{% endfor %} $(CONTEXT_MAIN_OBJECTS) $(REPAIR_CONTEXT_MAIN_OBJECTS) $(AUTO_EXTRA_SOURCES) bhf_driver.o $(BUILD_CONTEXT_LDFLAGS) $(SECTION_LDFLAGS) $(AUTO_EXTRA_LDFLAGS) $(BHF_TOOLCHAIN_LDFLAGS) $(BHF_TOOLCHAIN_LIBS)

# Semantic check only: the same translation units under the same flags as
# `main`, minus code generation and the link. The repair loop reads compiler
# diagnostics, and a round that is going to fail has nothing to learn from the
# object code it would emit. Prebuilt objects are deliberately absent from both
# the prerequisites and the recipe: nothing is linked here, and passing an `.o`
# to `-fsyntax-only` is an error. Undefined symbols therefore cannot surface in
# this mode — they are found by the real build, which still runs before any
# target is called successful.
syntaxcheck: main.c
	$(CC) $(CFLAGS) $(SECTION_FLAGS) $(C_COMPAT_FLAGS) $(FEATURE_TEST_FLAGS) $(COMPILE_DB_FLAGS) $(BHF_TOOLCHAIN_TARGET_FLAGS) $(BHF_TOOLCHAIN_CFLAGS) $(C_STD_FLAG) $(INCLUDES) $(AUTO_EXTRA_INCLUDES) $(BHF_TOOLCHAIN_CPPFLAGS) $(BHF_TOOLCHAIN_C_CPPFLAGS) $(call BHF_SANITIZED_NO_FORTIFY,$(CFLAGS)) -DBHF_EXTERNAL_DRIVER -fsyntax-only main.c{% for src in target_sources %} {{ src }}{% endfor %} $(AUTO_EXTRA_SOURCES)

afl: main_afl

main_afl: main.c $(CONTEXT_AFL_OBJECTS) $(REPAIR_CONTEXT_AFL_OBJECTS)
	$(AFLPP_CC) $(AFLPP_CFLAGS) $(SECTION_FLAGS) $(C_COMPAT_FLAGS) $(FEATURE_TEST_FLAGS) $(COMPILE_DB_FLAGS) $(C_STD_FLAG) $(INCLUDES) $(AUTO_EXTRA_INCLUDES) $(BHF_TOOLCHAIN_CPPFLAGS) $(BHF_TOOLCHAIN_C_CPPFLAGS) $(call BHF_SANITIZED_NO_FORTIFY,$(AFLPP_CFLAGS)) -o $@ main.c{% for src in target_sources %} {{ src }}{% endfor %} $(CONTEXT_AFL_OBJECTS) $(REPAIR_CONTEXT_AFL_OBJECTS) $(AUTO_EXTRA_SOURCES) $(BUILD_CONTEXT_LDFLAGS) $(SECTION_LDFLAGS) $(AUTO_EXTRA_LDFLAGS) $(BHF_TOOLCHAIN_LIBS)

# Portable libFuzzer binary (also drivable by Mayhem coverage-guided / honggfuzz).
{%- if passthrough_libfuzzer_entrypoint is defined and passthrough_libfuzzer_entrypoint %}
# The project's own source defines `LLVMFuzzerTestOneInput`, so libFuzzer drives
# it directly: the project sources are linked with `-fsanitize=fuzzer` and neither
# main.c (bhf's driver around the same entry point) nor a shim is compiled.
# bhf_driver.o is intentionally NOT linked. See PORTABILITY.md.
libfuzzer: main_libfuzzer

main_libfuzzer: $(CONTEXT_MAIN_OBJECTS) $(REPAIR_CONTEXT_MAIN_OBJECTS)
	$(LIBFUZZER_CC) $(LIBFUZZER_CFLAGS) $(SECTION_FLAGS) $(C_COMPAT_FLAGS) $(FEATURE_TEST_FLAGS) $(COMPILE_DB_FLAGS) $(C_STD_FLAG) $(INCLUDES) $(AUTO_EXTRA_INCLUDES) $(BHF_TOOLCHAIN_CPPFLAGS) $(BHF_TOOLCHAIN_C_CPPFLAGS) $(call BHF_SANITIZED_NO_FORTIFY,$(LIBFUZZER_CFLAGS)) -o $@{% for src in target_sources %} {{ src }}{% endfor %} $(CONTEXT_MAIN_OBJECTS) $(REPAIR_CONTEXT_MAIN_OBJECTS) $(AUTO_EXTRA_SOURCES) $(BUILD_CONTEXT_LDFLAGS) $(SECTION_LDFLAGS) $(AUTO_EXTRA_LDFLAGS) $(BHF_TOOLCHAIN_LIBS)
{%- else %}
# Compiled with -DBHF_EXTERNAL_DRIVER so main.c emits only `bhf_run_one` (no bhf
# `main`, no bhf coverage runtime); bhf_libfuzzer.c adds `LLVMFuzzerTestOneInput`
# and a no-op `bhf_target_enter`; `-fsanitize=fuzzer` supplies `main` + coverage.
# bhf_driver.o is intentionally NOT linked. See PORTABILITY.md.
libfuzzer: main_libfuzzer

main_libfuzzer: main.c bhf_libfuzzer.c $(CONTEXT_MAIN_OBJECTS) $(REPAIR_CONTEXT_MAIN_OBJECTS)
	$(LIBFUZZER_CC) $(LIBFUZZER_CFLAGS) $(SECTION_FLAGS) $(C_COMPAT_FLAGS) $(FEATURE_TEST_FLAGS) $(COMPILE_DB_FLAGS) $(C_STD_FLAG) $(INCLUDES) $(AUTO_EXTRA_INCLUDES) $(BHF_TOOLCHAIN_CPPFLAGS) $(BHF_TOOLCHAIN_C_CPPFLAGS) $(call BHF_SANITIZED_NO_FORTIFY,$(LIBFUZZER_CFLAGS)) -DBHF_EXTERNAL_DRIVER -o $@ main.c bhf_libfuzzer.c{% for src in target_sources %} {{ src }}{% endfor %} $(CONTEXT_MAIN_OBJECTS) $(REPAIR_CONTEXT_MAIN_OBJECTS) $(AUTO_EXTRA_SOURCES) $(BUILD_CONTEXT_LDFLAGS) $(SECTION_LDFLAGS) $(AUTO_EXTRA_LDFLAGS) $(BHF_TOOLCHAIN_LIBS)
{%- endif %}

msan: main_msan

main_msan: main.c bhf_driver_msan.o $(CONTEXT_MSAN_OBJECTS) $(REPAIR_CONTEXT_MSAN_OBJECTS)
	$(MSAN_CC) $(MSAN_CFLAGS) $(SECTION_FLAGS) $(C_COMPAT_FLAGS) $(FEATURE_TEST_FLAGS) $(COMPILE_DB_FLAGS) $(C_STD_FLAG) $(INCLUDES) $(AUTO_EXTRA_INCLUDES) $(BHF_TOOLCHAIN_CPPFLAGS) $(BHF_TOOLCHAIN_C_CPPFLAGS) $(call BHF_SANITIZED_NO_FORTIFY,$(MSAN_CFLAGS)) -DBHF_EXTERNAL_DRIVER -o $@ main.c{% for src in target_sources %} {{ src }}{% endfor %} $(CONTEXT_MSAN_OBJECTS) $(REPAIR_CONTEXT_MSAN_OBJECTS) $(AUTO_EXTRA_SOURCES) bhf_driver_msan.o $(BUILD_CONTEXT_LDFLAGS) $(SECTION_LDFLAGS) $(AUTO_EXTRA_LDFLAGS) $(BHF_TOOLCHAIN_LIBS)

tsan: main_tsan

main_tsan: main.c bhf_driver_tsan.o $(CONTEXT_TSAN_OBJECTS) $(REPAIR_CONTEXT_TSAN_OBJECTS)
	$(TSAN_CC) $(TSAN_CFLAGS) $(SECTION_FLAGS) $(C_COMPAT_FLAGS) $(FEATURE_TEST_FLAGS) $(COMPILE_DB_FLAGS) $(C_STD_FLAG) $(INCLUDES) $(AUTO_EXTRA_INCLUDES) $(BHF_TOOLCHAIN_CPPFLAGS) $(BHF_TOOLCHAIN_C_CPPFLAGS) $(call BHF_SANITIZED_NO_FORTIFY,$(TSAN_CFLAGS)) -DBHF_EXTERNAL_DRIVER -o $@ main.c{% for src in target_sources %} {{ src }}{% endfor %} $(CONTEXT_TSAN_OBJECTS) $(REPAIR_CONTEXT_TSAN_OBJECTS) $(AUTO_EXTRA_SOURCES) bhf_driver_tsan.o $(BUILD_CONTEXT_LDFLAGS) $(SECTION_LDFLAGS) $(AUTO_EXTRA_LDFLAGS) $(BHF_TOOLCHAIN_LIBS)

cov: main_cov

main_cov: main.c bhf_driver_cov.o $(CONTEXT_COV_OBJECTS) $(REPAIR_CONTEXT_COV_OBJECTS)
	$(COV_CC) $(COV_CFLAGS) $(SECTION_FLAGS) $(C_COMPAT_FLAGS) $(FEATURE_TEST_FLAGS) $(COMPILE_DB_FLAGS) $(C_STD_FLAG) $(INCLUDES) $(AUTO_EXTRA_INCLUDES) $(BHF_TOOLCHAIN_CPPFLAGS) $(BHF_TOOLCHAIN_C_CPPFLAGS) $(call BHF_SANITIZED_NO_FORTIFY,$(COV_CFLAGS)) -DBHF_EXTERNAL_DRIVER -o $@ main.c{% for src in target_sources %} {{ src }}{% endfor %} $(CONTEXT_COV_OBJECTS) $(REPAIR_CONTEXT_COV_OBJECTS) $(AUTO_EXTRA_SOURCES) bhf_driver_cov.o $(BUILD_CONTEXT_LDFLAGS) $(SECTION_LDFLAGS) $(AUTO_EXTRA_LDFLAGS) $(BHF_TOOLCHAIN_LIBS)

diff: main_diff

main_diff: main.c bhf_driver_diff.o $(CONTEXT_DIFF_OBJECTS) $(REPAIR_CONTEXT_DIFF_OBJECTS)
	$(DIFF_CC) $(DIFF_CFLAGS) $(SECTION_FLAGS) $(C_COMPAT_FLAGS) $(FEATURE_TEST_FLAGS) $(COMPILE_DB_FLAGS) $(INCLUDES) $(AUTO_EXTRA_INCLUDES) $(BHF_TOOLCHAIN_CPPFLAGS) $(BHF_TOOLCHAIN_C_CPPFLAGS) $(call BHF_SANITIZED_NO_FORTIFY,$(DIFF_CFLAGS)) -DBHF_EXTERNAL_DRIVER -o $@ main.c{% for src in target_sources %} {{ src }}{% endfor %} $(CONTEXT_DIFF_OBJECTS) $(REPAIR_CONTEXT_DIFF_OBJECTS) $(AUTO_EXTRA_SOURCES) bhf_driver_diff.o $(BUILD_CONTEXT_LDFLAGS) $(SECTION_LDFLAGS) $(AUTO_EXTRA_LDFLAGS) $(BHF_TOOLCHAIN_LIBS)

# Build-recovery provenance (stub-artifact vs real-defect): the SAME ASan build as
# `main`, but the injected stubs come from $(AUTO_PROV_SOURCES) — a poisoned copy in
# which every value-returning stub records its name and _Exit()s on call. Replaying a
# crash's min input through this binary tells `auto` whether the crash needed a
# fabricated stub value (a stub fired -> lab_only) or reproduced with none on its
# path (provably stub-independent -> confidence raised).
prov: main_prov

main_prov: main.c bhf_driver.o bhf_toolchain.stamp $(CONTEXT_PROV_OBJECTS) $(REPAIR_CONTEXT_PROV_OBJECTS)
	$(CC) $(CFLAGS) $(SECTION_FLAGS) $(C_COMPAT_FLAGS) $(FEATURE_TEST_FLAGS) $(COMPILE_DB_FLAGS) $(BHF_TOOLCHAIN_TARGET_FLAGS) $(BHF_TOOLCHAIN_CFLAGS) $(C_STD_FLAG) $(INCLUDES) $(AUTO_EXTRA_INCLUDES) $(BHF_TOOLCHAIN_CPPFLAGS) $(BHF_TOOLCHAIN_C_CPPFLAGS) $(call BHF_SANITIZED_NO_FORTIFY,$(CFLAGS)) -DBHF_EXTERNAL_DRIVER -o $@ main.c{% for src in target_sources %} {{ src }}{% endfor %} $(CONTEXT_PROV_OBJECTS) $(REPAIR_CONTEXT_PROV_OBJECTS) $(AUTO_PROV_SOURCES) bhf_driver.o $(BUILD_CONTEXT_LDFLAGS) $(SECTION_LDFLAGS) $(AUTO_EXTRA_LDFLAGS) $(BHF_TOOLCHAIN_LDFLAGS) $(BHF_TOOLCHAIN_LIBS)

clean:
	rm -f main main_afl main_libfuzzer main_msan main_tsan main_cov main_prov main_diff bhf_driver.o bhf_driver_msan.o bhf_driver_tsan.o bhf_driver_cov.o bhf_driver_diff.o bhf_toolchain.stamp
	rm -rf context_objs repair_context_objs
