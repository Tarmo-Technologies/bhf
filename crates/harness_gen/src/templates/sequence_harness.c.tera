/* Project headers may redirect getenv to a restricted project wrapper. The
 * generated runtime must still see its BHF_* control variables via libc. */
#ifdef getenv
#undef getenv
#endif

/* Sanitizer-runtime callbacks (edge coverage + cmplog operand capture, #400)
 * must never be instrumented themselves: with `-fsanitize-coverage=trace-cmp`
 * on, an un-attributed compare inside one of these would recurse into the
 * trace-cmp callback and tank throughput on every edge. Mark them all NOCOV. */
#ifndef BHF_NOCOV
#if defined(__has_attribute)
#if defined(__clang__) && __has_attribute(no_sanitize)
#define BHF_NOCOV __attribute__((no_sanitize("coverage")))
#elif __has_attribute(no_sanitize_coverage)
#define BHF_NOCOV __attribute__((no_sanitize_coverage))
#elif __has_attribute(no_sanitize)
#define BHF_NOCOV __attribute__((no_sanitize("coverage")))
#endif
#endif
#endif
#ifndef BHF_NOCOV
#define BHF_NOCOV
#endif

{%- if expert_jpeg_decompress %}
/* libjpeg reports malformed input through a caller-installed fatal callback.
 * Recover to the fuzz iteration boundary; allowing the default callback to
 * exit(1) would turn ordinary parse rejection into a false crash. */
struct _bhf_jpeg_error {
    struct jpeg_error_mgr pub;
    jmp_buf jump;
};
static void _bhf_jpeg_error_exit(j_common_ptr cinfo) {
    struct _bhf_jpeg_error *error = (struct _bhf_jpeg_error *)cinfo->err;
    longjmp(error->jump, 1);
}
{%- endif %}

/* Keep value-returning lifecycle calls observable when a source-local target is
 * visible to the optimizer; `(void)result` alone permits dead-code removal. */
#if defined(__GNUC__) || defined(__clang__)
#define BHF_KEEP_RESULT(value) \
    __asm__ __volatile__("" : : "g"(&(value)) : "memory")
#else
#define BHF_KEEP_RESULT(value) ((void)(value))
#endif

{%- if callback_actions %}
/* Stateful callback actions observed in the maintained expert harness. The
 * callback can request any observed public transition with a bounded,
 * deterministic input-controlled choice. Invocation and recursion caps prevent
 * a callback cycle from monopolizing one fuzz iteration. */
static const uint8_t *_bhf_callback_data;
static size_t _bhf_callback_size;
static size_t _bhf_callback_index;
static unsigned _bhf_callback_calls;
static BHF_NOCOV void _bhf_callback_begin(const uint8_t *data, size_t size) {
    _bhf_callback_data = data;
    _bhf_callback_size = size;
    _bhf_callback_index = 0;
    _bhf_callback_calls = 0;
}
static BHF_NOCOV void _bhf_callback_observe(void *context) {
    uint8_t _bhf_callback_choice;
    if (!context || !_bhf_callback_size || _bhf_callback_calls++ >= 8u) return;
    _bhf_callback_choice = _bhf_callback_data[_bhf_callback_index++ % _bhf_callback_size];
    if ((_bhf_callback_choice & 3u) != 1u) return;
{%- for callback_action in callback_actions %}
    {% if loop.first %}if{% else %}else if{% endif %} (((_bhf_callback_choice >> 2) % {{ callback_actions | length }}u) == {{ loop.index0 }}u) {
        (void){{ callback_action.name }}(({{ callback_action.handle_param_type }})context{% for arg in callback_action.args %}, {{ arg }}{% endfor %});
    }
{%- endfor %}
}
#define BHF_CALLBACK_OBSERVE(context) _bhf_callback_observe((void *)(context))
{%- endif %}

