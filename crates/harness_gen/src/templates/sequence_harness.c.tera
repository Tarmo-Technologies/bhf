    if (_bhf_handle_live) {
{%- for p in end_step.params %}
    {{ p.decl }};
{%- endfor %}
    {% if end_step.return_type_present %}{{ end_step.return_type }} {{ end_step.result_name }} = {% endif %}{{ end_step.name }}({% if handle_is_pointer_value %}_bhf_handle{% else %}&_bhf_handle{% endif %}{% for p in end_step.params %}, {{ p.arg }}{% endfor %});
