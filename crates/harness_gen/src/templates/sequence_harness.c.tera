    BHF_KEEP_RESULT({{ end_step.result_name }});
{%- endif %}
{%- for p in end_step.params %}
{%- if p.free %}
    {{ p.free }};
{%- endif %}
{%- endfor %}
    }
{%- endif %}
{%- for step in configure_steps %}
{%- for p in step.params %}
{%- if p.free %}
