{#- Recovered project flags apply to this generated TU too. Projects such as
    libarchive use `-Wmissing-prototypes -Werror`; declare bhf's exported
    driver hooks before their definitions without weakening the project's warning
    policy. #}
int bhf_run_one(const uint8_t *Data, size_t Size);
int LLVMFuzzerTestOneInput(const uint8_t *Data, size_t Size);

/* Auto-injected by bhf: republish fuzz input to the Linux runtrace shim so
 * fuzz-driven mode can route the current iteration's bytes into fake fds /
 * socket peers / dlopen stubs. Windows has no preload shim and must not emit a
 * COFF weak reference: multiple weak defaults conflict under link.exe. */
#if defined(_WIN32)
#define BHF_PUBLISH_INPUT(data, size) ((void)0)
#else
extern void bhf_shim_set_fuzz_input(const uint8_t *data, size_t size) __attribute__((weak));
#define BHF_PUBLISH_INPUT(data, size) do { \
    if (bhf_shim_set_fuzz_input) bhf_shim_set_fuzz_input((data), (size)); \
} while (0)
#endif
#if defined(BHF_EXTERNAL_DRIVER)
extern void bhf_target_enter(void);
#define BHF_TARGET_ENTER() bhf_target_enter()
#else
#define BHF_TARGET_ENTER() ((void)0)
#endif
int bhf_run_one(const uint8_t *Data, size_t Size) {
    BHF_PUBLISH_INPUT(Data, Size);
{%- if expert_jpeg_decompress %}
    /* Public libjpeg decompressor lifecycle, matching maintained expert
     * harnesses. The decoder owns every internal controller; synthesizing
     * those private objects from fuzz bytes violates the API contract. */
    struct jpeg_decompress_struct _bhf_cinfo;
    struct _bhf_jpeg_error _bhf_error;
    memset(&_bhf_cinfo, 0, sizeof _bhf_cinfo);
    memset(&_bhf_error, 0, sizeof _bhf_error);
    _bhf_cinfo.err = jpeg_std_error(&_bhf_error.pub);
    _bhf_error.pub.error_exit = _bhf_jpeg_error_exit;
    if (setjmp(_bhf_error.jump)) {
        jpeg_destroy_decompress(&_bhf_cinfo);
        return 0;
    }
    jpeg_create_decompress(&_bhf_cinfo);
    jpeg_mem_src(&_bhf_cinfo, Data, (unsigned long)Size);
    BHF_TARGET_ENTER();
    int _bhf_header = jpeg_read_header(&_bhf_cinfo, TRUE);
    BHF_KEEP_RESULT(_bhf_header);
    if (_bhf_header == JPEG_HEADER_OK && jpeg_start_decompress(&_bhf_cinfo)) {
        size_t _bhf_stride = (size_t)_bhf_cinfo.output_width *
                            (size_t)_bhf_cinfo.output_components;
        if (_bhf_stride != 0 &&
            _bhf_stride <= (size_t)((JDIMENSION)-1)) {
            JSAMPARRAY _bhf_row = (*_bhf_cinfo.mem->alloc_sarray)(
                (j_common_ptr)&_bhf_cinfo, JPOOL_IMAGE,
                (JDIMENSION)_bhf_stride, 1);
            /* Bound pathological dimensions so one decompression bomb cannot
             * monopolize a fuzz worker. Normal images drain completely. */
            size_t _bhf_rows = 0;
            while (_bhf_cinfo.output_scanline < _bhf_cinfo.output_height &&
                   _bhf_rows++ < 65536u) {
                if (jpeg_read_scanlines(&_bhf_cinfo, _bhf_row, 1) == 0) break;
            }
            if (_bhf_cinfo.output_scanline >= _bhf_cinfo.output_height) {
                (void)jpeg_finish_decompress(&_bhf_cinfo);
            }
        }
    }
    jpeg_destroy_decompress(&_bhf_cinfo);
{%- elif expert_sqlite_prepare %}
    /* Public SQLite VM lifecycle, matching its expert harness: copy/NUL-terminate
     * the SQL program, compile every statement, execute its VM, finalize it,
     * and advance through the tail before closing the in-memory database. */
    if (Size == SIZE_MAX) return 0;
    char *_bhf_sql = (char *)malloc(Size + 1u);
    if (!_bhf_sql) return 0;
    memcpy(_bhf_sql, Data, Size);
    _bhf_sql[Size] = '\0';
    sqlite3 *_bhf_db = NULL;
    if (sqlite3_open(":memory:", &_bhf_db) == SQLITE_OK) {
        const char *_bhf_tail = _bhf_sql;
        const char *_bhf_end = _bhf_sql + Size;
        for (size_t _bhf_statement = 0;
             _bhf_statement < 256u && _bhf_tail < _bhf_end && *_bhf_tail;
             ++_bhf_statement) {
            sqlite3_stmt *_bhf_stmt = NULL;
            const char *_bhf_next = NULL;
            size_t _bhf_remaining = (size_t)(_bhf_end - _bhf_tail);
            int _bhf_sql_bytes = _bhf_remaining > (size_t)INT_MAX
                                    ? INT_MAX
