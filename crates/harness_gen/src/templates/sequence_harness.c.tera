            BHF_TARGET_ENTER();
            int _bhf_prepare = sqlite3_prepare_v2(
                _bhf_db, _bhf_tail, _bhf_sql_bytes, &_bhf_stmt, &_bhf_next);
            BHF_KEEP_RESULT(_bhf_prepare);
