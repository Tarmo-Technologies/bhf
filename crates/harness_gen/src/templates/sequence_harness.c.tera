    memset(&_bhf_slot_{{ slot.slug }}, 0, sizeof _bhf_slot_{{ slot.slug }});
    int _bhf_slot_{{ slot.slug }}_live = 0;
{%- endfor %}
    for (size_t _bhf_lifecycle_index = 0; _bhf_lifecycle_index < _bhf_lifecycle_count; ++_bhf_lifecycle_index) {
        switch ((int)bhf_ctrl_op(Data, Size, _bhf_lifecycle_index, {{ op_max_steps }}, {{ op_steps | length }})) {
{%- for step in op_steps %}
        case {{ loop.index0 }}: {
{%- if step.receiver_selector %}
            int {{ step.receiver_selector }} = (int)bhf_u8(&Cur);
