    {{ object.constructor.return_type }} {{ object.handle_name }} = {{ object.constructor.name }}({% if object.constructor_uses_parent %}{{ object.constructor.receiver }}{% if object.constructor.params | length > 0 %}, {% endif %}{% endif %}{% for p in object.constructor.params %}{{ p.arg }}{% if not loop.last %}, {% endif %}{% endfor %});
