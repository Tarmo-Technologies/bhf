<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!--
  A CMSIS-SVD description of the small part the fixture firmware images
  run on: the USART that irq.c and uart.c drive, a second one derived from
  it, two timers as a peripheral array, a peripheral with a reserved block,
  and the System Control Block, which the core models itself. Registers are
  given for the USART only, the way vendor files give them; a window comes
  from a peripheral's address blocks, not its registers.
-->
<device schemaVersion="1.3" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="CMSIS-SVD.xsd">
  <vendor>Widget Devices</vendor>
  <name>WIDGET_M4</name>
  <version>1.0</version>
  <description>Fixture Cortex-M4 part &amp; its peripherals</description>
  <cpu>
    <name>CM4</name>
    <revision>r0p1</revision>
    <endian>little</endian>
    <mpuPresent>false</mpuPresent>
    <fpuPresent>false</fpuPresent>
    <nvicPrioBits>4</nvicPrioBits>
    <vendorSystickConfig>false</vendorSystickConfig>
  </cpu>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <size>0x20</size>
  <resetValue>0x00000000</resetValue>
  <peripherals>
    <peripheral>
      <name>USART1</name>
      <description><![CDATA[Universal <synchronous/asynchronous> receiver transmitter]]></description>
      <groupName>USART</groupName>
      <baseAddress>0x40011000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x400</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>USART1</name>
        <description>USART1 global interrupt</description>
        <value>37</value>
      </interrupt>
      <registers>
        <register>
          <name>SR</name>
          <description>Status register</description>
          <addressOffset>0x0</addressOffset>
          <size>0x20</size>
          <resetValue>0x00C0</resetValue>
          <fields>
            <field>
              <name>RXNE</name>
              <description>Read data register not empty</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>DR</name>
          <description>Data register</description>
          <addressOffset>0x4</addressOffset>
          <size>0x20</size>
        </register>
        <register>
          <name>CR1</name>
          <description>Control register 1</description>
          <addressOffset>0xC</addressOffset>
          <size>0x20</size>
        </register>
      </registers>
    </peripheral>
    <peripheral derivedFrom="USART1">
      <name>USART2</name>
      <baseAddress>0x40004400</baseAddress>
      <interrupt>
        <name>USART2</name>
        <value>38</value>
      </interrupt>
    </peripheral>
    <peripheral>
      <dim>2</dim>
      <dimIncrement>0x400</dimIncrement>
      <dimIndex>2,3</dimIndex>
      <name>TIM%s</name>
      <description>General-purpose timers</description>
      <baseAddress>0x40000000</baseAddress>
      <addressBlock>
        <offset>0</offset>
        <size>1K</size>
        <usage>registers</usage>
      </addressBlock>
    </peripheral>
    <peripheral>
      <name>CRC</name>
      <description>Cyclic redundancy check unit: its first word only, the rest reserved</description>
      <baseAddress>0x40023000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x4</size>
        <usage>registers</usage>
      </addressBlock>
      <addressBlock>
        <offset>0x4</offset>
        <size>0x3fc</size>
        <usage>reserved</usage>
      </addressBlock>
    </peripheral>
    <peripheral>
      <name>SCB</name>
      <description>System control block</description>
      <baseAddress>0xE000ED00</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x41</size>
        <usage>registers</usage>
      </addressBlock>
    </peripheral>
  </peripherals>
</device>
