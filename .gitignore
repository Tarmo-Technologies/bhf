/ada_runtime/lib/
/ada_runtime/obj/
/editors/vscode/node_modules/
/editors/vscode/out/
/target/
/bhf_work/
/dist/
__pycache__/

# Internal design plans/specs generated during development.
/docs/superpowers/

# libFuzzer crash / leak / timeout / OOM artifacts the harness drops
# in CWD when an input triggers a finding. Test runs under
# crates/cli/ otherwise pollute the workspace with thousands of these.
crates/*/leak-*
crates/*/crash-*
crates/*/timeout-*
crates/*/oom-*
crates/*/bhf_work/

# Playwright MCP browser-automation artifacts (page snapshots, console logs).
# Written into the repo root by the driving tool, not by the project. Note this
# keeps them out of commits only: `spdx_check` walks the working tree and does
# not consult .gitignore, so it still reports them as missing an SPDX header.
# Delete the directory before running the license-audit gate.
/.playwright-mcp/

# Docker sweep transient data (fetched corpus + run outputs)
/docker/corpus/
/docker/results/
