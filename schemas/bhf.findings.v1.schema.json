{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tarmo-Technologies/bhf/schemas/bhf.findings.v1.schema.json",
  "title": "bhf.findings.v1",
  "description": "Every finding from every bhf producer in one work dir. Written to <work>/results/findings.json by `results::rebuild`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "tool", "source", "producers", "counts", "findings", "groups", "errors"],
  "properties": {
    "schema_version": { "const": "bhf.findings.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "tool": { "$ref": "#/$defs/tool" },
    "source": { "$ref": "#/$defs/source" },
    "producers": { "type": "array", "items": { "$ref": "#/$defs/producer" } },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "by_kind", "by_severity", "by_confirmation"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "by_kind": { "$ref": "#/$defs/count_map" },
        "by_severity": { "$ref": "#/$defs/count_map" },
        "by_confirmation": { "$ref": "#/$defs/count_map" }
      }
    },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "representative", "members"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "representative": { "type": "string", "minLength": 1 },
          "members": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "observations": {
            "description": "For a group of fuzz or runtime findings at one sink (its first project frame and bug family): each call stack the sink was reached through, with its members. Absent when there is one.",
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "members"],
              "properties": {
                "key": { "type": "string", "minLength": 1 },
                "members": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
              }
            }
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": { "path": { "type": "string" }, "reason": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "build_fidelity": {
      "description": "Inputs bhf fabricated so the harness compiled because the build context did not supply them (written only when there are any).",
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "fabricated"],
      "properties": {
        "level": { "enum": ["reduced"] },
        "context": { "$ref": "#/$defs/nullable_string" },
        "fabricated": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "name"],
            "properties": {
              "kind": { "enum": ["macro", "header", "type", "include_dir"] },
              "name": { "type": "string", "minLength": 1 },
              "value": { "$ref": "#/$defs/nullable_string" }
            }
          }
        }
      }
    },
    "count_map": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "nullable_string": { "type": ["string", "null"] },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "build"],
      "properties": {
        "name": { "const": "bhf" },
        "version": { "type": "string", "minLength": 1 },
        "build": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "vcs"],
      "properties": {
        "root": { "$ref": "#/$defs/nullable_string" },
        "vcs": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "commit", "branch", "dirty"],
              "properties": {
                "kind": { "const": "git" },
                "commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
                "branch": { "$ref": "#/$defs/nullable_string" },
                "dirty": { "type": ["boolean", "null"] }
              }
            }
          ]
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "argv", "started_at", "finished_at", "status", "exit_code", "findings_total"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "argv": { "type": "array", "items": { "type": "string" } },
        "started_at": { "type": "string", "format": "date-time" },
        "finished_at": { "type": "string", "format": "date-time" },
        "status": { "enum": ["complete", "partial"] },
        "exit_code": { "type": "integer" },
        "findings_total": { "type": "integer", "minimum": 0 }
      }
    },
    "kind": { "enum": ["fuzz", "runtime", "static", "binary", "differential", "sca"] },
    "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
    "confirmation_level": {
      "enum": ["sanitizer_crash", "runtime_oracle", "capability", "crash_lead", "intended_rejection", "static_confirmed", "static", "advisory"]
    },
    "memory_access": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "size", "address_hint", "region", "alloc_stack", "free_stack"],
      "properties": {
        "direction": { "enum": ["read", "write", "unknown"] },
        "size": { "type": ["integer", "null"], "minimum": 0 },
        "address_hint": { "$ref": "#/$defs/nullable_string" },
        "region": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "size", "offset", "relation", "distance", "variable", "frame_offset"],
              "properties": {
                "kind": { "type": "string", "minLength": 1 },
                "size": { "type": ["integer", "null"], "minimum": 0 },
                "offset": { "type": ["integer", "null"] },
                "relation": { "$ref": "#/$defs/nullable_string" },
                "distance": { "type": ["integer", "null"], "minimum": 0 },
                "variable": { "$ref": "#/$defs/nullable_string" },
                "frame_offset": { "type": ["integer", "null"], "minimum": 0 }
              }
            }
          ]
        },
        "alloc_stack": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/frame" } },
        "free_stack": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/frame" } },
        "parameter": {
          "description": "The harness parameter whose buffer the access hit, or null when the argument trace named none. Added after the first v1 release, so documents written before it omit the key.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "offset", "basis"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "offset": { "type": ["integer", "null"] },
                "basis": { "enum": ["region_start", "region_interior", "nearest_pointer"] }
              }
            }
          ]
        },
        "allocated_by_harness": {
          "description": "Whether bhf's generated harness allocated the buffer the access hit (its frames are left out of alloc_stack, which keeps project frames only): false for a project allocation or the fuzz driver's copy of the input, null when no allocation stack was recorded. Added after the first v1 release, so documents written before it omit the key.",
          "type": ["boolean", "null"]
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function", "file", "line"],
      "properties": {
        "function": { "$ref": "#/$defs/nullable_string" },
        "file": { "$ref": "#/$defs/nullable_string" },
        "line": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "input_to_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "len", "operand_hex", "compared_with_hex", "cmp_kind", "site", "site_location", "relation", "operands_equal"],
      "properties": {
        "offset": { "type": "integer", "minimum": 0 },
        "len": { "type": "integer", "minimum": 1 },
        "operand_hex": { "type": "string", "pattern": "^([0-9a-f]{2})*$" },
        "compared_with_hex": { "type": "string", "pattern": "^([0-9a-f]{2})*$" },
        "cmp_kind": { "enum": ["cmp", "switch", "float_cmp", "double_cmp", "memcmp", "strcmp", "strncmp", "strcasecmp", "strncasecmp"] },
        "site": { "type": "string", "pattern": "^0x[0-9a-f]+$" },
        "site_location": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/location" }] },
        "relation": { "enum": ["equal", "byte_swapped", "derived"] },
        "operands_equal": { "type": "boolean" }
      }
    },
    "argument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "value", "len", "span", "preview_hex", "role", "after_call_value"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "value": { "$ref": "#/$defs/nullable_string" },
        "len": { "type": ["integer", "null"], "minimum": 0 },
        "span": {
          "oneOf": [
            { "type": "null" },
            { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 2, "maxItems": 2 }
          ]
        },
        "preview_hex": { "$ref": "#/$defs/nullable_string" },
        "role": { "enum": ["param", "receiver", "out"] },
        "after_call_value": { "$ref": "#/$defs/nullable_string" }
      }
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "lineage": {
      "description": "A fuzz finding's seed lineage: the root its input descends from and how many mutation generations down it is. origin is mined_seed or user_seed (a seed auto/seeds.json or the bhf fuzz command line names), seed (a start input no seed list names), corpus (a reseeded queue entry whose own ancestry was not recorded), generated (no seed: an empty or built-in start input, or one a generator built) or unknown (reason says why; nothing is guessed).",
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "root_sha256", "root_path", "layout_prefix", "depth", "parent_sha256", "donor_sha256", "reason"],
      "properties": {
        "origin": { "enum": ["mined_seed", "user_seed", "seed", "corpus", "generated", "unknown"] },
        "root_sha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
        "root_path": { "$ref": "#/$defs/nullable_string" },
        "layout_prefix": { "type": ["integer", "null"], "minimum": 1 },
        "depth": { "type": ["integer", "null"], "minimum": 0 },
        "parent_sha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
        "donor_sha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
        "reason": { "$ref": "#/$defs/nullable_string" }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line", "column", "function"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "column": { "type": ["integer", "null"], "minimum": 1 },
        "function": { "$ref": "#/$defs/nullable_string" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "kind", "producer", "rule", "title", "message", "explanation", "severity", "impact",
        "confidence", "cwe", "confirmation", "verdict", "location", "fix_location", "stack", "trace",
        "fingerprint", "group", "occurrences", "first_seen", "last_seen", "reachability", "fidelity",
        "remediation", "patch_hints", "reproduce", "evidence", "fuzz", "static", "sca", "binary", "raw_ref"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "kind": { "$ref": "#/$defs/kind" },
        "producer": { "enum": ["auto", "fuzz", "static-scan", "binary fuzz", "binary rehost", "kernel import", "kernel fuzz", "differential", "sbom"] },
        "rule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "slug", "name"],
          "properties": {
            "id": { "$ref": "#/$defs/nullable_string" },
            "slug": { "$ref": "#/$defs/nullable_string" },
            "name": { "$ref": "#/$defs/nullable_string" }
          }
        },
        "title": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "explanation": { "$ref": "#/$defs/nullable_string" },
        "severity": { "$ref": "#/$defs/severity" },
        "impact": { "$ref": "#/$defs/nullable_string" },
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "score"],
          "properties": {
            "level": { "enum": ["high", "medium", "low", "unknown"] },
            "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
          }
        },
        "cwe": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1 },
        "confirmation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "detail"],
          "properties": {
            "level": { "$ref": "#/$defs/confirmation_level" },
            "detail": { "$ref": "#/$defs/nullable_string" }
          }
        },
        "verdict": { "$ref": "#/$defs/nullable_string" },
        "verdict_reason": {
          "description": "Why verdict is lab_only or blocked, or null for the other verdicts: stubbed_value (the crash needed a value a stub, mock or fake supplied), missing_resource (blocked by a resource the run could not find), allocator_only_leak, contract_assertion, short_slice_precondition, harness_cleanup, must_panic, enum_domain_precondition, harness_sized_buffer (an overflow of a buffer bhf's harness sized for a pointer parameter it passes without a length), mmio_register (a SEGV on a fixed device-register address, which no device backs on the host) or entry_not_input (the entry's signature does not take input). Added after the first v1 release, so documents written before it omit the key.",
          "enum": [null, "stubbed_value", "missing_resource", "allocator_only_leak", "contract_assertion", "short_slice_precondition", "harness_cleanup", "must_panic", "enum_domain_precondition", "harness_sized_buffer", "mmio_register", "entry_not_input"]
        },
        "location": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/location" }] },
        "fix_location": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/location" }] },
        "stack": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["function", "file", "line"],
            "properties": {
              "function": { "$ref": "#/$defs/nullable_string" },
              "file": { "$ref": "#/$defs/nullable_string" },
              "line": { "type": ["integer", "null"], "minimum": 1 }
            }
          }
        },
        "trace": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "line", "function", "note"],
            "properties": {
              "file": { "type": "string" },
              "line": { "type": ["integer", "null"], "minimum": 1 },
              "function": { "$ref": "#/$defs/nullable_string" },
              "note": { "$ref": "#/$defs/nullable_string" }
            }
          }
        },
        "fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary", "signature"],
          "properties": {
            "primary": { "type": "string", "minLength": 1 },
            "signature": { "$ref": "#/$defs/nullable_string" }
          }
        },
        "group": { "$ref": "#/$defs/nullable_string" },
        "occurrences": { "type": "integer", "minimum": 1 },
        "first_seen": { "type": ["string", "null"], "format": "date-time" },
        "last_seen": { "type": ["string", "null"], "format": "date-time" },
        "reachability": { "type": ["object", "null"] },
        "fidelity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stubs_used", "forced", "caveats"],
          "properties": {
            "stubs_used": { "type": "boolean" },
            "forced": { "type": "boolean" },
            "caveats": { "type": "array", "items": { "type": "string" } }
          }
        },
        "remediation": { "$ref": "#/$defs/nullable_string" },
        "patch_hints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "guidance"],
            "properties": { "title": { "type": "string" }, "guidance": { "type": "string" } }
          }
        },
        "reproduce": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["harness_id", "command", "build"],
              "properties": {
                "harness_id": { "$ref": "#/$defs/nullable_string" },
                "command": { "$ref": "#/$defs/nullable_string" },
                "build": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["sanitizers", "binary_sha256", "build_id"],
                  "properties": {
                    "sanitizers": { "type": "array", "items": { "type": "string" } },
                    "binary_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
                    "build_id": { "type": ["string", "null"], "pattern": "^[0-9a-f]+$" },
                    "fidelity": { "$ref": "#/$defs/build_fidelity" }
                  }
                }
              }
            }
          ]
        },
        "evidence": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["dir", "files"],
              "properties": {
                "dir": { "type": "string", "pattern": "^findings/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
                "files": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["role", "path", "sha256", "size"],
                    "properties": {
                      "role": { "enum": ["finding", "testcase", "testcase_minimized", "sanitizer_log", "decoded", "replay_script", "repro_ada", "byte_control", "runtrace", "console_log", "repro_syz", "repro_c"] },
                      "path": { "type": "string", "pattern": "^findings/" },
                      "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
                      "size": { "type": "integer", "minimum": 0 }
                    }
                  }
                }
              }
            }
          ]
        },
        "fuzz": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["exception", "classification", "harness_id", "dialect", "oracle"],
              "properties": {
                "exception": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "message", "sanitizer"],
                  "properties": {
                    "name": { "$ref": "#/$defs/nullable_string" },
                    "message": { "$ref": "#/$defs/nullable_string" },
                    "sanitizer": { "$ref": "#/$defs/nullable_string" }
                  }
                },
                "classification": { "$ref": "#/$defs/nullable_string" },
                "harness_id": { "$ref": "#/$defs/nullable_string" },
                "dialect": { "$ref": "#/$defs/nullable_string" },
                "oracle": { "type": ["object", "null"] },
                "access": {
                  "description": "The memory access the sanitizer reported, without its raw address. Added after the first v1 release, so documents written before it omit the key.",
                  "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/memory_access" }]
                },
                "input_to_state": {
                  "description": "Comparison evidence recorded while the finding's input ran: null when no capture ran or it could not run, [] when one ran and no input bytes fed a comparison. Added after the first v1 release.",
                  "oneOf": [{ "type": "null" }, { "type": "array", "items": { "$ref": "#/$defs/input_to_state" } }]
                },
                "input_to_state_input": {
                  "description": "The finding file whose bytes the input_to_state offsets index (min_testcase.bin or testcase.bin), or null when the capture did not name it. Added after the first v1 release.",
                  "type": ["string", "null"]
                },
                "input_to_state_status": {
                  "description": "What the comparison-evidence capture found: recorded, no_input_comparisons, no_comparisons or unavailable; null when no capture ran. Added after the first v1 release.",
                  "oneOf": [{ "type": "null" }, { "enum": ["recorded", "no_input_comparisons", "no_comparisons", "unavailable"] }]
                },
                "input_to_state_reason": {
                  "description": "Why the capture recorded no comparison evidence, when it recorded none. Added after the first v1 release.",
                  "type": ["string", "null"]
                },
                "input_to_state_search": {
                  "description": "How far the capture's search for operands computed from input bytes (range checks) got; null when it did not run or was not recorded. Added after the first v1 release.",
                  "oneOf": [
                    { "type": "null" },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["state", "searched_bytes", "input_len"],
                      "properties": {
                        "state": { "enum": ["done", "partial", "too_long"] },
                        "searched_bytes": { "type": "integer", "minimum": 0 },
                        "input_len": { "type": "integer", "minimum": 0 }
                      }
                    }
                  ]
                },
                "arguments": {
                  "description": "The values the harness decoded from the input and passed to the target, when traced. Added after the first v1 release.",
                  "oneOf": [{ "type": "null" }, { "type": "array", "items": { "$ref": "#/$defs/argument" } }]
                },
                "sanitizer_second_opinion": {
                  "description": "Which report a finding first reported as UBSan's insufficient-object-size carries, after a re-run with that check suppressed (finding.json sanitizer_second_opinion): used asan when AddressSanitizer reported the same access, ubsan when the first report stands; reason says why. null for every other finding. Added after the first v1 release, so documents written before it omit the key.",
                  "oneOf": [
                    { "type": "null" },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["check", "used", "reason"],
                      "properties": {
                        "check": { "enum": ["object-size"] },
                        "used": { "enum": ["asan", "ubsan"] },
                        "reason": { "type": "string", "minLength": 1 }
                      }
                    }
                  ]
                },
                "lineage": {
                  "description": "What the finding's input descends from in the fuzz queue (finding.json lineage); null when the finding records none. Added after the first v1 release, so documents written before it omit the key.",
                  "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/lineage" }]
                }
              }
            }
          ]
        },
        "static": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["engine", "precision", "snippet", "baseline_status", "triage_state"],
              "properties": {
                "engine": { "$ref": "#/$defs/nullable_string" },
                "precision": {},
                "snippet": { "$ref": "#/$defs/nullable_string" },
                "baseline_status": { "$ref": "#/$defs/nullable_string" },
                "triage_state": { "$ref": "#/$defs/nullable_string" }
              }
            }
          ]
        },
        "sca": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["vuln_id", "aliases", "component", "fixed_versions", "cvss", "kev", "references", "match_confidence", "matching_method", "vex"],
              "properties": {
                "vuln_id": { "type": "string", "minLength": 1 },
                "aliases": { "type": "array", "items": { "type": "string" } },
                "component": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "version", "ecosystem", "purl", "cpe"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "version": { "$ref": "#/$defs/nullable_string" },
                    "ecosystem": { "$ref": "#/$defs/nullable_string" },
                    "purl": { "$ref": "#/$defs/nullable_string" },
                    "cpe": { "$ref": "#/$defs/nullable_string" }
                  }
                },
                "fixed_versions": { "type": "array", "items": { "type": "string" } },
                "cvss": { "type": ["object", "null"] },
                "kev": {},
                "references": { "type": "array" },
                "match_confidence": { "$ref": "#/$defs/nullable_string" },
                "matching_method": { "$ref": "#/$defs/nullable_string" },
                "vex": { "type": ["object", "null"] }
              }
            }
          ]
        },
        "binary": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["sha256", "build_id", "arch", "crash"],
              "properties": {
                "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
                "build_id": { "$ref": "#/$defs/nullable_string" },
                "arch": { "$ref": "#/$defs/nullable_string" },
                "crash": { "type": ["object", "null"] }
              }
            }
          ]
        },
        "raw_ref": { "$ref": "#/$defs/nullable_string" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "sca" } } }, "then": { "properties": { "sca": { "type": "object" } } } },
        { "if": { "properties": { "kind": { "const": "static" } } }, "then": { "properties": { "static": { "type": "object" } } } },
        { "if": { "properties": { "kind": { "enum": ["fuzz", "runtime", "differential"] } } }, "then": { "properties": { "fuzz": { "type": "object" } } } },
        { "if": { "properties": { "kind": { "const": "binary" } } }, "then": { "properties": { "binary": { "type": "object" } } } }
      ]
    }
  }
}
