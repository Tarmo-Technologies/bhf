{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Tarmo-Technologies/bhf/schemas/bhf.finding.v1.schema.json",
  "title": "bhf.finding.v1",
  "description": "Envelope every <work>/results/findings/<id>/finding.json carries. Producer-specific fields are open; bhf.findings.v1 is the normalized view.",
  "type": "object",
  "required": ["schema_version", "id", "finding_kind", "created_at"],
  "properties": {
    "schema_version": { "const": "bhf.finding.v1" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "finding_kind": { "$ref": "bhf.findings.v1.schema.json#/$defs/kind" },
    "created_at": { "type": "string", "format": "date-time" },
    "last_seen": { "type": "string", "format": "date-time" },
    "forced": { "type": "boolean" },
    "forced_note": { "type": "string" },
    "gates": {
      "description": "Comparison evidence recorded by replaying the finding's input (gate_capture.input): each input span whose bytes reached a comparison of the target.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["offset", "len", "operand_hex", "compared_with_hex", "cmp_kind", "site", "relation", "operands_equal"],
        "properties": {
          "offset": { "type": "integer", "minimum": 0 },
          "len": { "type": "integer", "minimum": 1 },
          "operand_hex": { "type": "string", "pattern": "^([0-9a-f]{2})*$" },
          "compared_with_hex": { "type": "string", "pattern": "^([0-9a-f]{2})*$" },
          "cmp_kind": { "type": "string" },
          "site": { "type": "string", "pattern": "^0x[0-9a-f]+$" },
          "location": {
            "type": ["object", "null"],
            "properties": {
              "file": { "type": "string" },
              "line": { "type": ["integer", "null"] },
              "function": { "type": ["string", "null"] }
            }
          },
          "relation": { "enum": ["equal", "byte_swapped", "derived"] },
          "operands_equal": { "type": "boolean" }
        }
      }
    },
    "gate_capture": {
      "description": "How the comparison evidence in gates was recorded, or why there is none.",
      "type": "object",
      "required": ["input", "input_len", "status"],
      "properties": {
        "input": { "type": "string" },
        "input_len": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["recorded", "no_input_comparisons", "no_comparisons", "unavailable"] },
        "reason": { "type": ["string", "null"] },
        "comparisons": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" },
        "unconfirmed": { "type": "integer", "minimum": 0 },
        "runs": { "type": "integer", "minimum": 0 },
        "shim_armed": { "type": "boolean" },
        "runner": {
          "description": "The emulator the capture replayed a harness built for another platform under (qemu-aarch64); absent for a native replay.",
          "type": "string"
        }
      }
    },
    "build": {
      "description": "How the harness that produced the finding was built.",
      "type": "object",
      "properties": {
        "binary": {
          "description": "The harness binary's identity; null when it could not be read.",
          "type": ["object", "null"],
          "properties": {
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "build_id": { "type": ["string", "null"] },
            "coverage_instrumentation": {
              "description": "The instrumentation that fed the edge map, read from the binary; absent when the binary does not show one.",
              "enum": ["sancov-trace-pc-guard", "sancov-trace-pc", "go-cover"]
            }
          }
        }
      }
    },
    "harness": {
      "description": "The input format of the generated harness that found it. Readers prefer it to the older top-level harness_format_version and buffer_len_dimension, which are still written.",
      "type": "object",
      "required": ["format_version"],
      "properties": {
        "format_version": { "type": "integer", "minimum": 1 },
        "buffer_len_dimension": { "type": "boolean" }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "command", "fields"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "command": { "type": "string" },
          "fields": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
