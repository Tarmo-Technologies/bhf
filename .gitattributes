# Text is checked out with LF on every host, Windows included. bhf embeds its
# templates, runtime sources and scripts in its binaries and writes them back
# out, so a CRLF checkout would put carriage returns into generated harness
# sources and shell scripts, and tests would read fixtures that differ from
# the ones Linux reads.
* text=auto eol=lf

# Windows command scripts keep CRLF line endings.
*.bat text eol=crlf
*.cmd text eol=crlf

